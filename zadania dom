zad.2 znalezienie najwiekszej wartości w tablicy 
int main(void) {
    
    int marks[]= {1,2,3,3,4,5,2,5,6,7};
    int max=marks[0];


    for(int i=1; i<10; i++){
        if(marks[i]>max){
            max=marks[i];
        }
    }
    printf("Maksymalna wartosc to: %d\n", max);
    return 0;
}

zad.3 zamiana miejscami elementów tablicy 1 i ostatni (pamietać, że numerowanie w C zaczyna się od 0)
temp -> temporary
int main(void) {
    
    int tab[]= {10,20,30,40};
    int temp;

    printf("Oryginalna tablica: \n");
    for(int i=0; i<4; i++){
        printf("tab[%d]=%d\n", i, tab[i]);
    }
    printf("\n");
    temp=tab[0];
    tab[0]=tab[3];
    tab[3]=temp;

    printf("Tablica po zmianie: \n");
    for(int i=0; i<4; i++){
        printf("tab[%d]=%d\n", i, tab[i]);
    }
    return 0;
}

zad.4 sortowanie bąbelkowe
int main(void){
    int tab[]={9,2,7,4,6,5,3,0};
    int temp;

    printf("Poczatkowa tablica: \n");
    for(int i=0; i<8; i++){
        printf("%d\n", tab[i]);
    }
    for(int i=0; i<7; i++){
        for(int j=0; j<7-i; j++){
            if(tab[j]>tab[j+1]){
             temp=tab[j];
             tab[j]=tab[j+1];
             tab[j+1]=temp;
            }
        }
    }
    printf("\n");

    printf("Posortowana tablica: \n");
    for(int i=0; i<8; i++){
        printf("%d\n", tab[i]);
    }
    return 0;
}
